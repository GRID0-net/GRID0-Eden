if (NOT DEFINED EDEN_CROSS_TRIPLE)
    message(FATAL_ERROR "Use LinuxX86_64.cmake or WindowsX86_64.cmake")
endif()

set(EDEN_CROSS_SYSROOT "$ENV{EDEN_CROSS_SYSROOT}" CACHE PATH "Target dependency sysroot")
if (NOT IS_ABSOLUTE "${EDEN_CROSS_SYSROOT}" OR NOT IS_DIRECTORY "${EDEN_CROSS_SYSROOT}")
    message(FATAL_ERROR "Set EDEN_CROSS_SYSROOT to an existing absolute target sysroot")
endif()

set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_FIND_ROOT_PATH "${EDEN_CROSS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

find_program(EDEN_CROSS_CC NAMES "${EDEN_CROSS_TRIPLE}-gcc" REQUIRED)
find_program(EDEN_CROSS_CXX NAMES "${EDEN_CROSS_TRIPLE}-g++" REQUIRED)
set(CMAKE_C_COMPILER "${EDEN_CROSS_CC}")
set(CMAKE_CXX_COMPILER "${EDEN_CROSS_CXX}")
set(FFmpeg_CROSS_PREFIX "${EDEN_CROSS_TRIPLE}-" CACHE STRING "FFmpeg cross compiler prefix")
set(PKG_CONFIG_EXECUTABLE "${CMAKE_CURRENT_LIST_DIR}/grid0-pkg-config.sh" CACHE FILEPATH "Target pkg-config wrapper")
set(ENV{EDEN_CROSS_SYSROOT} "${EDEN_CROSS_SYSROOT}")

if (DEFINED ENV{EDEN_QT_HOST_PATH})
    set(QT_HOST_PATH "$ENV{EDEN_QT_HOST_PATH}" CACHE PATH "Native Qt build tools")
endif()
